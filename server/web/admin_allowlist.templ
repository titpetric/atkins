package web

import "github.com/titpetric/atkins/server/model"

// allowlistView shows the policy, warns when the two disagree with what
// an operator probably meant, and lists the rules.
templ allowlistView(page *allowlistPage) {
	@layout("Allowlist", 0) {
		@navbar(page.Page)
		<h2>Repository allowlist</h2>
		<p class="muted">
			Policy in force: <span class="mono">{ page.Policy }</span>.
			Change it under <a href="/admin/setting">Settings</a>, as
			<span class="mono">repository.policy</span>.
		</p>
		if page.Policy == model.PolicyOpen {
			<p class="flash">
				The policy is <span class="mono">open</span>: every repository a logged-in
				user dispatches will be built, and the rules below are not consulted.
				Write the rules first, then switch the policy.
			</p>
		} else if page.ActiveRules == 0 {
			<p class="flash flash-error">
				The policy is <span class="mono">allowlist</span> and no rule is active, so
				<strong>nothing will run</strong> — every dispatch and every trigger is
				refused. Add a rule, or set the policy back to <span class="mono">open</span>.
			</p>
		}
		<fieldset>
			<legend>Add a rule</legend>
			<form method="post" action="/admin/allowlist">
				<input type="hidden" name="csrf_token" value={ page.CSRF }/>
				<label for="pattern">Pattern</label>
				<input id="pattern" type="text" name="pattern" placeholder="github.com/titpetric/*" required/>
				<label for="description">Description</label>
				<input id="description" type="text" name="description" placeholder="why this is allowed"/>
				<p><button type="submit" class="primary">Add rule</button></p>
			</form>
			<p class="muted">
				Patterns match the normalized <span class="mono">host/owner/name</span> slug.
				<span class="mono">*</span> matches within a path segment,
				<span class="mono">**</span> across segments, so
				<span class="mono">github.com/**</span> is every repository on one host.
			</p>
		</fieldset>
		if len(page.Rules) > 0 {
			<table>
				<tr>
					<th>Pattern</th>
					<td>State</td>
					<td>Added</td>
					<td>Actions</td>
				</tr>
				for _, rule := range page.Rules {
					<tr>
						<th class="mono">
							{ rule.Pattern }
							if rule.Description != "" {
								<div class="muted">{ rule.Description }</div>
							}
						</th>
						<td>
							if rule.IsActive {
								<span class="badge badge-on">active</span>
							} else {
								<span class="badge badge-off">disabled</span>
							}
						</td>
						<td class="muted">{ stamp(rule.CreatedAt) }</td>
						<td>
							<div class="actions">
								<form method="post" action={ templ.URL("/admin/allowlist/" + rule.ID) } class="inline">
									<input type="hidden" name="csrf_token" value={ page.CSRF }/>
									if rule.IsActive {
										<button type="submit" name="action" value="disable">Disable</button>
									} else {
										<button type="submit" name="action" value="enable">Enable</button>
									}
								</form>
								<form method="post" action={ templ.URL("/admin/allowlist/" + rule.ID) } class="inline">
									<input type="hidden" name="csrf_token" value={ page.CSRF }/>
									<button type="submit" name="action" value="remove">Remove</button>
								</form>
							</div>
						</td>
					</tr>
				}
			</table>
		} else {
			<p class="muted">No rules yet.</p>
		}
		<p class="muted">
			The rule is enforced twice: the server refuses the dispatch, and the agent
			checks again before it clones. A job can outlive the rule that admitted it.
		</p>
	}
}
