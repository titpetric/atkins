package web

import "strconv"

// layout is the shell every page sits in.
//
// It was `{{define "head"}}` before: a fragment each page pasted into
// its own `<head>`, which meant every page repeated the doctype, the
// html element and the body. As a component it can hold the whole
// document and take the page as children, so a page is only its own
// content.
templ layout(title string, refresh int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — atkins</title>
			if refresh > 0 {
				<meta http-equiv="refresh" content={ strconv.Itoa(refresh) }/>
			}
			@styles()
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// navbar is the header every admin page carries: where you are, who you
// are, and the way out.
//
// Signing out is a form because logging somebody out on a GET is
// something a preloading browser can do by itself.
templ navbar(page Page) {
	<header>
		<h1>atkins</h1>
		<nav>
			<a href="/">Jobs</a>
			<a
				href="/admin/project"
				if page.Section == sectionProjects {
					class="current"
				}
			>Projects</a>
			<a
				href="/admin/repository"
				if page.Section == sectionRepositories {
					class="current"
				}
			>Repositories</a>
			<a
				href="/admin/allowlist"
				if page.Section == sectionAllowlist {
					class="current"
				}
			>Allowlist</a>
			<a
				href="/admin/setting"
				if page.Section == sectionSettings {
					class="current"
				}
			>Settings</a>
			<a
				href="/admin/user"
				if page.Section == sectionUsers {
					class="current"
				}
			>Users</a>
			<a
				href="/admin/ssh-key"
				if page.Section == sectionKeys {
					class="current"
				}
			>Deploy keys</a>
			<span class="spacer"></span>
			<form method="post" action="/logout" class="inline">
				<input type="hidden" name="csrf_token" value={ page.CSRF }/>
				<button type="submit" class="link">Sign out { page.User.Username }</button>
			</form>
		</nav>
	</header>
	if page.Notice != "" {
		<p class="flash flash-notice">{ page.Notice }</p>
	}
	if page.Error != "" {
		<p class="flash flash-error">{ page.Error }</p>
	}
}

// styles is the whole stylesheet.
//
// It stays inline rather than becoming a served file: a job page is
// opened once, from a link somebody pasted, and a second request for a
// few kilobytes of CSS buys nothing. A <style> element's contents are
// raw in templ, so this is the same text it always was.
templ styles() {
	<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #1b1b1f;
    --muted: #6a6a75;
    --line: #e2e2e8;
    --panel: #f7f7f9;
    --accent: #3b6ea5;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16161a;
      --fg: #e6e6ea;
      --muted: #9a9aa5;
      --line: #2b2b33;
      --panel: #1e1e24;
      --accent: #7aa7d9;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    max-width: 60rem;
    background: var(--bg);
    color: var(--fg);
    font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  a { color: var(--accent); }
  h1 { font-size: 1.35rem; margin: 0 0 .25rem; }
  h2 { font-size: 1rem; margin: 2rem 0 .5rem; }
  header { border-bottom: 1px solid var(--line); padding-bottom: 1rem; margin-bottom: 1rem; }
  .muted { color: var(--muted); }
  code, pre, .mono { font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace; }
  pre {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: .85rem 1rem;
    overflow-x: auto;
    font-size: 13px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  /* Job output keeps the colours the command wrote. The palette is
     muted against both themes rather than the terminal's own: a build
     log is read on a page here, not in a terminal, and a saturated
     green on white is a colour nobody can read. */
  .ansi-bold      { font-weight: 600; }
  .ansi-dim       { opacity: .7; }
  .ansi-italic    { font-style: italic; }
  .ansi-underline { text-decoration: underline; }

  .ansi-fg-black   { color: #3b3b45; }
  .ansi-fg-red     { color: #b4514f; }
  .ansi-fg-green   { color: #4b9460; }
  .ansi-fg-yellow  { color: #a07a1f; }
  .ansi-fg-blue    { color: #3b6ea5; }
  .ansi-fg-magenta { color: #9155a8; }
  .ansi-fg-cyan    { color: #2b8087; }
  .ansi-fg-white   { color: var(--fg); }
  .ansi-fg-bright-black   { color: var(--muted); }
  .ansi-fg-bright-red     { color: #d06a67; }
  .ansi-fg-bright-green   { color: #5cb075; }
  .ansi-fg-bright-yellow  { color: #c2962c; }
  .ansi-fg-bright-blue    { color: #5b8cc4; }
  .ansi-fg-bright-magenta { color: #ac6ec4; }
  .ansi-fg-bright-cyan    { color: #359aa2; }
  .ansi-fg-bright-white   { color: var(--fg); }

  .ansi-bg-black   { background: #3b3b45; color: #f7f7f9; }
  .ansi-bg-red     { background: #b4514f; color: #ffffff; }
  .ansi-bg-green   { background: #4b9460; color: #ffffff; }
  .ansi-bg-yellow  { background: #a07a1f; color: #ffffff; }
  .ansi-bg-blue    { background: #3b6ea5; color: #ffffff; }
  .ansi-bg-magenta { background: #9155a8; color: #ffffff; }
  .ansi-bg-cyan    { background: #2b8087; color: #ffffff; }
  .ansi-bg-white   { background: #e2e2e8; color: #1b1b1f; }
  .ansi-bg-bright-black   { background: #6a6a75; color: #ffffff; }
  .ansi-bg-bright-red     { background: #d06a67; color: #ffffff; }
  .ansi-bg-bright-green   { background: #5cb075; color: #1b1b1f; }
  .ansi-bg-bright-yellow  { background: #c2962c; color: #1b1b1f; }
  .ansi-bg-bright-blue    { background: #5b8cc4; color: #ffffff; }
  .ansi-bg-bright-magenta { background: #ac6ec4; color: #ffffff; }
  .ansi-bg-bright-cyan    { background: #359aa2; color: #ffffff; }
  .ansi-bg-bright-white   { background: #f7f7f9; color: #1b1b1f; }

  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; width: 11rem; }
  .badge {
    display: inline-block;
    padding: .1rem .5rem;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid transparent;
  }
  .badge-pending   { background: #f0e6c8; color: #6b5411; }
  .badge-running   { background: #cfe0f5; color: #1d456e; }
  .badge-passed    { background: #cfe9d4; color: #1d5c2c; }
  .badge-failed    { background: #f4d2d2; color: #7a2020; }
  .badge-timeout   { background: #eddbc4; color: #74451a; }
  .badge-cancelled { background: #e0e0e6; color: #4a4a55; }
  .badge-on        { background: #cfe9d4; color: #1d5c2c; }
  .badge-off       { background: #e0e0e6; color: #4a4a55; }

  /* Admin pages: navigation, forms and flash messages. The controls
     are plain HTML — a form post and a redirect — so the pages work
     with scripting off and there is no build step to keep alive. */
  nav { display: flex; flex-wrap: wrap; gap: .9rem; align-items: baseline; margin-top: .5rem; }
  nav a { text-decoration: none; }
  nav a.current { font-weight: 600; text-decoration: underline; }
  nav .spacer { flex: 1; }
  .flash {
    border: 1px solid var(--line);
    border-left-width: 4px;
    border-radius: 4px;
    padding: .6rem .8rem;
    margin: 0 0 1rem;
  }
  .flash-notice { border-left-color: #4b9460; background: var(--panel); }
  .flash-error  { border-left-color: #b4514f; background: var(--panel); }
  form.inline { display: inline; }
  fieldset { border: 1px solid var(--line); border-radius: 6px; padding: .9rem 1rem; margin: 0 0 1.5rem; }
  legend { color: var(--muted); padding: 0 .35rem; }
  label { display: block; margin: .5rem 0 .15rem; color: var(--muted); font-size: 13px; }
  input[type=text], input[type=email], input[type=password], select, textarea {
    width: 100%;
    max-width: 34rem;
    padding: .35rem .5rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: 14px;
  }
  textarea { min-height: 7rem; font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace; font-size: 13px; }
  button {
    padding: .3rem .7rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--panel);
    color: var(--fg);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  button:hover:enabled { border-color: var(--accent); color: var(--accent); }
  button:disabled { cursor: not-allowed; opacity: .5; }
  button.primary { border-color: var(--accent); color: var(--accent); }
  button.link { border: 0; background: none; color: var(--accent); padding: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: .35rem; }
  .warn { border-left-color: #b4514f; }

  /* The pipeline picker. A <select> cannot nest past one level of
     <optgroup> and job names nest as deep as somebody writes them, so
     the control is a <details> holding a tree of radio buttons: a
     dropdown assembled out of parts that work without any script. */
  .picker {
    max-width: 34rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
  }
  .picker > summary {
    padding: .35rem .5rem;
    cursor: pointer;
    font-size: 14px;
    list-style-position: inside;
  }
  .picker[open] > summary { border-bottom: 1px solid var(--line); }
  .tree { max-height: 24rem; overflow-y: auto; padding: .35rem .5rem .6rem; }
  .tree-section + .tree-section { margin-top: .6rem; border-top: 1px solid var(--line); padding-top: .6rem; }
  .tree-section-name { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .tree-level { list-style: none; margin: .15rem 0 0; padding: 0; }
  .tree-level .tree-level { border-left: 1px solid var(--line); padding-left: .5rem; }
  .tree-group { color: var(--muted); font-size: 13px; }
  .tree-job {
    display: flex;
    align-items: baseline;
    gap: .4rem;
    margin: 0;
    padding: .1rem .25rem;
    border-radius: 3px;
    color: var(--fg);
    font-size: 13px;
    cursor: pointer;
  }
  .tree-job:hover { background: var(--panel); }
  .tree-job input { margin: 0; }
  .tree-job .muted { font-size: 12px; }
</style>
}
