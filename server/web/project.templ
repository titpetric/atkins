package web

import (
	"strconv"

	"github.com/titpetric/atkins/server/pipeline"
)

// projectsView lists the projects and offers the form that adds one.
templ projectsView(page *projectsPage) {
	@layout("Projects", 0) {
		@navbar(page.Page)
		<h2>Projects</h2>
		if len(page.Projects) > 0 {
			<table>
				<tr>
					<th>Project</th>
					<td>Pipeline</td>
					<td>Last job</td>
				</tr>
				for _, project := range page.Projects {
					<tr>
						<th>
							<a href={ templ.URL("/admin/project/" + project.ID) }>{ project.Name() }</a>
							<div class="muted mono">{ project.Slug }</div>
							if !project.Allowed {
								<div class="muted">not on the allowlist</div>
							}
						</th>
						<td>
							if project.Jobs > 0 {
								{ strconv.Itoa(project.Jobs) } jobs
							} else {
								<span class="muted">not read yet</span>
							}
						</td>
						<td>
							if project.LastJob != nil {
								<span class={ "badge", "badge-" + project.LastJob.Status }>{ project.LastJob.Status }</span>
								<div class="muted mono">{ project.LastJob.Command }</div>
							} else {
								<span class="muted">never built</span>
							}
						</td>
					</tr>
				}
			</table>
		}
		<h2>Add a project</h2>
		<p class="muted">
			Paste a clone address. An agent checks it out and reads its
			pipeline, so the jobs it offers are the ones the code actually
			declares.
			if page.Policy == "allowlist" {
				The allowlist is on, so a project also needs a rule before
				anything will run.
			}
		</p>
		<form method="post" action="/admin/project">
			<input type="hidden" name="csrf_token" value={ page.CSRF }/>
			<fieldset>
				<legend>Project</legend>
				<label for="remote_url">Git clone address</label>
				<input
					type="text"
					id="remote_url"
					name="remote_url"
					placeholder="https://github.com/owner/repo.git"
					required
					autofocus
				/>
				<label for="name">Name <span class="muted">— optional, defaults to the repository name</span></label>
				<input type="text" id="name" name="name" placeholder="what to call it here"/>
			</fieldset>
			<fieldset>
				<legend>Defaults for a run</legend>
				<label for="command">Arguments <span class="muted">— optional</span></label>
				<input type="text" id="command" name="command" placeholder="atkins test:simple"/>
				<label for="ref">Ref <span class="muted">— optional, defaults to the repository default branch</span></label>
				<input type="text" id="ref" name="ref" placeholder="branch, tag or commit"/>
				<label for="working_directory">Directory <span class="muted">— optional, where the pipeline file lives</span></label>
				<input type="text" id="working_directory" name="working_directory" placeholder="a path inside the repository"/>
			</fieldset>
			<p class="actions"><button type="submit" class="primary">Add project</button></p>
		</form>
	}
}

// projectView is one project: what it is, what it can run, and what it
// has run.
templ projectView(page *projectPage) {
	@layout(page.Name(), page.Refresh) {
		@navbar(page.Page)
		<h2>{ page.Name() }</h2>
		<table>
			<tr><th>Repository</th><td class="mono">{ page.Project.Slug }</td></tr>
			<tr><th>Remote</th><td class="mono">{ page.Project.RemoteURL }</td></tr>
			<tr>
				<th>Ref</th>
				<td class="mono">
					if page.Project.Ref != "" {
						{ page.Project.Ref }
					} else {
						<span class="muted">the default branch</span>
					}
				</td>
			</tr>
			if page.Project.WorkingDirectory != "" {
				<tr><th>Directory</th><td class="mono">{ page.Project.WorkingDirectory }</td></tr>
			}
			<tr>
				<th>Pipeline read</th>
				<td>
					if page.Project.PipelineAt != nil {
						{ stamp(page.Project.PipelineAt) }
					} else {
						<span class="muted">—</span>
					}
					<form method="post" action={ templ.URL("/admin/project/" + page.Project.ID + "/refresh") } class="inline">
						<input type="hidden" name="csrf_token" value={ page.CSRF }/>
						<button type="submit">Read it again</button>
					</form>
				</td>
			</tr>
		</table>
		<h2>Run a job</h2>
		if !page.Allowed {
			<p class="flash flash-error warn">
				The allowlist refuses this repository, so a run queued here would be
				refused too. Add a rule on the allowlist page.
			</p>
		}
		if page.Tree != nil {
			@runForm(page)
		} else {
			<p class="muted">
				if page.PipelineError != "" {
					{ page.PipelineError }
				} else {
					Reading the pipeline. An agent has to check the project out first.
				}
				if page.Listing != nil {
					<a href={ templ.URL(page.ListingLink) }>Open the job that reads it</a>
					(<span class={ "badge", "badge-" + page.Listing.Status }>{ page.Listing.Status }</span>).
				}
			</p>
		}
		<h2>Recent runs</h2>
		if len(page.Jobs) > 0 {
			<table>
				<tr>
					<th>Job</th>
					<td>Status</td>
					<td>Queued</td>
				</tr>
				for _, job := range page.Jobs {
					<tr>
						<th class="mono"><a href={ templ.URL(job.Link) }>{ job.Command }</a></th>
						<td>
							<span class={ "badge", "badge-" + job.Status }>{ job.Status }</span>
							if job.Interactive {
								<span class="badge badge-on">interactive</span>
							}
						</td>
						<td class="muted">{ stamp(job.CreatedAt) }</td>
					</tr>
				}
			</table>
		} else {
			<p class="muted">Nothing has run yet.</p>
		}
	}
}

// runForm is the pipeline picker and the button that dispatches it.
//
// The picker is a tree rather than a list because job names are a tree:
// `test:cover` is `cover` under `test`, and a project with forty jobs is
// four groups of ten rather than forty lines of one menu. A <select>
// cannot nest past one level of <optgroup>, which is why this is built
// out of parts instead of chosen from the shelf.
//
// The parts are <details> and radio buttons, so it is a dropdown without
// any script running: the summary opens the panel, the radios are the
// choice, and the form posts whichever one is set. What the script adds
// is the two things a native <select> does that these do not — show the
// current choice on the closed control, and close when one is made.
templ runForm(page *projectPage) {
	<form method="post" action={ templ.URL("/admin/project/" + page.Project.ID + "/run") }>
		<input type="hidden" name="csrf_token" value={ page.CSRF }/>
		<label for="job-picker">Job</label>
		<details class="picker" id="job-picker">
			<summary>
				<span data-picked>Choose a job</span>
			</summary>
			<div class="tree" role="group" aria-label="Pipeline jobs">
				for _, section := range page.Tree.Sections {
					<div class="tree-section">
						<div class="tree-section-name">{ section.Name }</div>
						@treeNodes(section.Nodes, 0)
					</div>
				}
			</div>
		</details>
		<label for="run_ref">Ref <span class="muted">— optional, overrides the project default for this run</span></label>
		<input type="text" id="run_ref" name="ref" placeholder="branch, tag or commit"/>
		<p class="actions">
			<button type="submit" class="primary" disabled?={ !page.Allowed }>Run</button>
		</p>
		@pickerScript()
	</form>
}

// pickerScript is the two behaviours a native <select> has that a
// <details> full of radios does not: the closed control names the
// current choice, and choosing closes it.
//
// Everything else about the picker works without this. It is inline for
// the same reason the stylesheet is — a page opened once should not cost
// a second request — and it is the whole of the scripting on this page.
templ pickerScript() {
	<script>
	  (function () {
	    var picker = document.getElementById('job-picker');
	    if (!picker) return;

	    var picked = picker.querySelector('[data-picked]');

	    picker.addEventListener('change', function (event) {
	      var radio = event.target;
	      if (!radio.matches || !radio.matches('input[type=radio][name=job]')) return;

	      picked.textContent = radio.value;
	      picker.open = false;
	    });
	  })();
	</script>
}

// treeNodes renders one level of the pipeline tree.
//
// A node that groups and a node that runs are the same element: `test`
// is a heading when the pipeline only declares `test:cover`, and a
// choice as well when it declares a `test` of its own. Rendering them
// differently would mean deciding which of the two a job like that is,
// and it is both.
templ treeNodes(nodes []*pipeline.Node, depth int) {
	<ul class="tree-level" style={ treeIndent(depth) }>
		for _, node := range nodes {
			<li>
				if node.Runnable() {
					<label class="tree-job">
						<input type="radio" name="job" value={ node.Command.ID } required/>
						<span class="mono">{ node.Label }</span>
						if node.Command.Interactive {
							<span class="badge badge-on" title="binds stdin: this one gets a keyboard">interactive</span>
						}
						if node.Command.Desc != "" {
							<span class="muted">{ node.Command.Desc }</span>
						}
					</label>
				} else {
					<span class="tree-group mono">{ node.Label }</span>
				}
				if len(node.Children) > 0 {
					@treeNodes(node.Children, depth+1)
				}
			</li>
		}
	</ul>
}

// treeIndent is the nesting offset for one level of the tree. It is a
// style attribute rather than a class because the depth is unbounded and
// a stylesheet cannot name every level.
func treeIndent(depth int) string {
	if depth == 0 {
		return ""
	}
	return "margin-left:" + strconv.Itoa(depth) + "rem"
}
